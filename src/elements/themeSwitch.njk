<button id="theme-toggle"
  class="w-9 h-5 py-2 ml-1.5 rounded-full bg-sii-light-accent dark:bg-sii-dark-hero-background flex items-center transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sii-primary cursor-pointer">
  <div id="theme-toggle-switch"
    class="flex justify-center items-center w-4 h-4 relative rounded-full transition-transform duration-300 -translate-x-1">
    <div id="theme-toggle-light-icon" class="hidden">
      {% feather "sun", { "stroke-width": 2, width: 12, height: 12, "stroke": "#fbfbfb" } %}
    </div>
    <div id="theme-toggle-dark-icon" class="hidden">
      {% feather "moon", { "stroke-width": 2, width: 12, height: 12, "stroke": "#fbfbfb" } %}
    </div>
  </div>
</button>
