<button data-theme-toggle type="button" aria-label="Toggle light/dark mode"
  class="group relative shrink-0 grid w-6 h-6 place-items-center rounded-full border border-white/15 text-white/75 transition-colors duration-200 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white cursor-pointer">
  <span class="grid place-items-center transition-transform duration-300 group-hover:rotate-12 dark:hidden">
    {% feather "moon", { "stroke-width": 1.5, width: 12, height: 12 } %}
  </span>
  <span class="hidden place-items-center transition-transform duration-300 group-hover:rotate-12 dark:grid">
    {% feather "sun", { "stroke-width": 1.5, width: 12, height: 12 } %}
  </span>
</button>
