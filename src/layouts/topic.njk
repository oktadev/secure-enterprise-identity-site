---
layout: base
---

<section class="sii-hero-bg relative overflow-hidden">
  <div class="absolute inset-0 sii-dotted-grid"></div>
  <div class="relative z-20 sii-shell py-6">
    {% set backLink = true %}
    {% include "_header.njk" %}
  </div>

  <div class="relative sii-shell py-10 md:py-14 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center" style="margin-top: -8rem;">
    <div class="space-y-5">
      <h1 class="text-5xl md:text-6xl leading-[1.05] tracking-tight text-white">{{ title }}</h1>
      <p class="text-base leading-relaxed text-white/75 max-w-lg">{{ description }}</p>
    </div>

    <div class="relative h-[260px] hidden lg:block">
      <div class="sii-orbit absolute" style="width: 470px; height: 155px; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-14deg);"></div>
      <div class="sii-device-mockup">
        <span class="block h-6 border-b-2 border-sii-primary/25"></span>
        <div class="sii-device-user"></div>
        <span class="sii-device-line" style="width: 130px; top: 60px;"></span>
        <span class="sii-device-line" style="width: 95px; top: 81px;"></span>
      </div>
      <div class="sii-identity-node absolute right-[16%] top-[15%]">
        {% feather icon or "lock", { "stroke-width": 1.5, width: 28, "class": "text-sii-primary dark:text-sii-primary-light" } %}
      </div>
    </div>
  </div>
</section>

<div class="sii-shell py-10 md:py-12 space-y-10">
  {% if learn %}
    {% set section = learn %}
    {% include "_resource_section.njk" %}
  {% endif %}

  {% if apply %}
    {% set section = apply %}
    {% include "_resource_section.njk" %}
  {% endif %}

  {% if reference %}
    {% set section = reference %}
    {% set compact = true %}
    {% include "_resource_section.njk" %}
  {% endif %}
</div>
