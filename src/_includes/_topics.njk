<section class="space-y-8">
  <div class="flex items-end justify-between gap-6 flex-wrap">
    <div class="space-y-2">
      <h2 class="text-sii-light-header dark:text-sii-dark-header text-4xl">Explore the core concepts</h2>
    </div>
  </div>
  <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {%- for item in collections.topic | sort(attribute='data.order') -%}
    <a href="{{item.page.url}}" class="group relative min-h-[220px] p-5 flex flex-col gap-2 bg-sii-light-background border border-sii-border rounded-xl transition-all duration-200 hover:shadow-lg hover:-translate-y-1 hover:border-sii-primary/40 dark:bg-sii-dark-muted dark:border-sii-dark-border">
      <div class="bg-sii-light-muted dark:bg-white/10 text-sii-primary dark:text-sii-primary-light p-2.5 rounded-lg w-fit mb-2">
        {% feather item.data.icon or "lock", { "stroke-width": 1.5, width: 22, height: 22 } %}
      </div>
      <span class="text-sii-primary text-xs font-bold tracking-widest uppercase">Explore</span>
      <h3 class="text-sii-light-header dark:text-sii-dark-header text-xl">{{item.data.title}}</h3>
      <div class="mt-auto flex items-end justify-between gap-4">
        <p class="text-sii-light-text dark:text-sii-dark-text text-sm">{{item.data.summary}}</p>
        <div class="shrink-0 text-sii-light-text dark:text-sii-dark-text transition-transform duration-200 group-hover:translate-x-1">
          {% feather "arrow-right", { "stroke-width": 1.5, width: 18 } %}
        </div>
      </div>
    </a>
  {%- endfor -%}
  </div>
</section>
