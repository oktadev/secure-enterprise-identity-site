<section class="space-y-8">
  <div class="space-y-4">
    <h2 class="text-sii-light-header dark:text-sii-dark-header text-5xl">{{topics.title}}</h2>
    <p class="text-lg">{{topics.subtitle}}</p>
  </div>
  <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {%- for item in collections.topic | sort(attribute='data.order') -%}
    <a href="{{item.page.url}}" class="group p-5 flex flex-col gap-4 bg-sii-light-muted dark:bg-sii-dark-muted rounded-xl transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
      <h3 class="text-sii-light-header dark:text-sii-dark-header text-2xl">{{item.data.title}}</h3>
      <p class="text-sii-light-text dark:text-sii-dark-text grow">{{item.data.summary}}</p>
      <div class="bg-sii-primary p-2.5 rounded-full w-fit self-end">
        {% feather "arrow-up-right", { "stroke-width": 1.5, "stroke": "#fbfbfb" } %}
      </div>
    </a>
  {%- endfor -%}
  </div>
</section>
