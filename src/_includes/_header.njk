<div class="flex justify-between items-center gap-3">
  <a class="sii-brand flex items-center gap-1.5 text-white" href="/">
    <img class="w-4" src="/img/favicon.svg" alt=""/>
    <span class="text-sm font-semibold">{{meta.title}}</span>
  </a>
  <div class="flex items-center gap-3">
    {% include "../elements/themeSwitch.njk" %}
    {% if backLink %}
    <a href="/" class="inline-flex items-center gap-2 whitespace-nowrap border border-white/15 text-white/80 rounded-md px-2.5 py-1 text-sm hover:text-white transition-colors duration-200">
      {% feather "arrow-left", { "stroke-width": 1.5, width: 12 } %}
      <span class="hidden sm:inline">Back to all concepts</span><span class="sm:hidden">All concepts</span>
    </a>
    {% else %}
    <a href="#identity-topics" class="hidden sm:inline-flex items-center gap-2 whitespace-nowrap text-white/80 text-sm font-medium hover:text-white transition-colors duration-200">
      Identity foundations
      {% feather "arrow-right", { "stroke-width": 1.5, width: 12 } %}
    </a>
    {% endif %}
  </div>
</div>
